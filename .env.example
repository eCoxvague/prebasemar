# =============================================================================
# Base Network Configuration
# =============================================================================
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# =============================================================================
# Smart Contract Configuration
# =============================================================================
# Contract addresses (filled after deployment)
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=

# Deployment wallet private key (DO NOT COMMIT!)
PRIVATE_KEY=

# Contract owner address
OWNER_ADDRESS=

# BaseScan API key for contract verification
BASESCAN_API_KEY=

# =============================================================================
# Farcaster Configuration
# =============================================================================
# Neynar API for Farcaster data
NEYNAR_API_KEY=

# Farcaster Hub URL (default: https://hub.farcaster.xyz)
FARCASTER_HUB_URL=https://hub.farcaster.xyz

# Farcaster Signer for creating casts/frames
FARCASTER_SIGNER_UUID=

# =============================================================================
# Application Configuration
# =============================================================================
# Your app's public URL (required for Farcaster frames)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Vercel KV (Redis Cache)
# =============================================================================
# These are automatically set by Vercel when you create a KV database
# For local development: vercel env pull
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# =============================================================================
# WalletConnect (for wallet connections)
# =============================================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
