{
  "name": "farcaster-prediction-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:node": "hardhat node",
    "hardhat:deploy:sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "hardhat:deploy:mainnet": "hardhat run scripts/deploy.ts --network base",
    "hardhat:verify:sepolia": "hardhat verify --network baseSepolia",
    "hardhat:verify:mainnet": "hardhat verify --network base"
  },
  "dependencies": {
    "@farcaster/auth-kit": "^0.8.1",
    "@hookform/resolvers": "^5.2.2",
    "@neynar/nodejs-sdk": "^3.34.0",
    "@tanstack/react-query": "^5.90.5",
    "@vercel/kv": "^3.0.0",
    "@wagmi/connectors": "^6.1.0",
    "@wagmi/core": "^2.22.1",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "viem": "^2.38.3",
    "wagmi": "^2.18.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typechain": "^8.3.2",
    "typescript": "^5"
  }
}
